<?xml version="1.0" encoding="UTF-8" standalone="no"?>

<beast beautitemplate='MultiTypeBirthDeath' beautistatus=''
       namespace="lineageTree.substitutionmodel.ScarringLoss:beast.pkgmgmt:beast.base.core:beast.base.inference:beast.base.evolution.alignment:beast.base.evolution.tree.coalescent:beast.base.util:beast.base.math:beast.evolution.nuc:beast.base.evolution.operator:beast.base.inference.operator:beast.base.evolution.sitemodel:beast.base.evolution.substitutionmodel:beast.base.evolution.likelihood"
       required="" version="2.6">

<plate var="n" range="$(range_tbcs)">
        <data id="data_$(n)" spec="feast.fileio.AlignmentFromNexus" name="alignment"
              fileName="data/mGASv2_Lane$(lane)_Clustering$(clustering)_Cluster$(cluster).alignment.targetBC=$(n).sciphy">
            <userDataType spec="beast.base.evolution.datatype.IntegerData"/>
        </data>
    </plate>

    <!-- set all tip dates, time points of sampling to 11 time units -->
    <traitSet id="dateTrait.t:alignment"
              spec="beast.base.evolution.tree.TraitSet"
              taxa="@TaxonSet.0" traitname="date-forward" value="$(first_cellID)=11"/>
    
    <!-- set of all cells -->
    <taxa id="TaxonSet.0" spec="TaxonSet">
        <alignment idref="data_1"/>
    </taxa>

    <plate var="n" range="$(range_tbcs)">
        <branchRateModel id="StrictClock_$(n)" spec="beast.base.evolution.branchratemodel.StrictClockModel"
                         clock.rate="@clockRate_$(n)"/>
    </plate>

    <parameter id="changeTimes" name="ChangeTimes">0 4 7.5 
    </parameter>

    <parameter id="arrayLength_1" value="$(array_length_1)" spec="parameter.IntegerParameter"/>
    <parameter id="arrayLength_2" value="$(array_length_2)"  spec="parameter.IntegerParameter"/>
    <parameter id="arrayLength_3" value="$(array_length_3)"  spec="parameter.IntegerParameter"/>
    <parameter id="arrayLength_4" value="$(array_length_4)" spec="parameter.IntegerParameter" />
    <parameter id="arrayLength_5" value="$(array_length_5)" spec="parameter.IntegerParameter"/>
    <parameter id="arrayLength_6" value="$(array_length_6)" spec="parameter.IntegerParameter"/>
    <parameter id="arrayLength_7" value="$(array_length_7)" spec="parameter.IntegerParameter"/>
    <parameter id="arrayLength_8" value="$(array_length_8)" spec="parameter.IntegerParameter"/>
    <parameter id="arrayLength_9" value="$(array_length_9)" spec="parameter.IntegerParameter"/>
    <parameter id="arrayLength_10" value="$(array_length_10)" spec="parameter.IntegerParameter"/>


    <!-- run MCMC with 10^9 steps -->
    <run id="mcmc" spec="MCMC" chainLength="1000000000" numInitializationAttempts="100">
      <operatorschedule spec="beast.base.evolution.operator.kernel.BactrianOperatorSchedule"/>
        <state id="state" spec="State" storeEvery="10000">

            <stateNode id="typewriterTree"  spec="sciphy.evolution.tree.startingTree" rootHeight="10.9999"
                       taxa="@data_$(TargetBC_initialization)" scarringHeight="10.999"
                       scarringDuration="0.0001" sequencesAreClustered="false">
                <trait idref="dateTrait.t:alignment"/>
                <taxonset idref="TaxonSet.0"/>
            </stateNode>
            
            <!-- editing model parameters -->
            <parameter id="editProbabilities" spec="parameter.RealParameter"
                       lower="0.0" name="stateNode" dimension="$(dimension_insertBC)"
                       upper="1">

                $(initialInsertProb)
            </parameter>
            <!-- clock rates, start value is median of prior -->
            <plate var="n" range="$(range_tbcs)">
                <parameter id="clockRate_$(n)" spec="parameter.RealParameter"
                           lower="0.0" name="stateNode"
                           upper="1000"> 0.2 </parameter>
            </plate>


            <parameter id="clockRate_" spec="parameter.RealParameter"
                       lower="0.0" name="stateNode"
                       upper="1000"> 0.2 </parameter>

            <parameter id="missProb_" spec="parameter.RealParameter"
                       lower="0.0" name="stateNode"
                       upper="1000"> 0.2 </parameter>

            <parameter id="missRate_" spec="parameter.RealParameter"
                       lower="0.0" name="stateNode"
                       upper="1000"> 0.2 </parameter>

            <!-- population process parameters -->
            <parameter id="birthRate" spec="parameter.RealParameter"
		       dimension="1" lower="0.0" name="stateNode"
		       upper="Infinity"> 0.5 0.5 0.5 </parameter>

            <parameter id="deathRate" spec="parameter.RealParameter"
                       dimension="1" lower="0.0" name="stateNode"
                       upper="Infinity">0.4 0.4 0.4 </parameter>

	     <!-- parameters for the birth rate OU prior -->
            <parameter spec='parameter.RealParameter' name="stateNode"
		       id='birthRate.mu' dimension="1" value="1"/>
            <parameter spec='parameter.RealParameter' name="stateNode"
		       id='birthRate.sigma' dimension="1" value="1"/>
            <parameter spec='parameter.RealParameter' name="stateNode"
		       id='birthRate.nu' dimension="1" value="0.1"/>

            <!-- parameters for the death rate OU prior -->
            <parameter spec='parameter.RealParameter' name="stateNode"
		       id='deathRate.mu' dimension="1" value="1"/>
            <parameter spec='parameter.RealParameter' name="stateNode"
		       id='deathRate.sigma' dimension="1" value="1"/>
            <parameter spec='parameter.RealParameter' name="stateNode"
		       id='deathRate.nu' dimension="1" value="0.1"/>

            <!-- The sampling rate through time is set to 0 as we only
                 sample at the end of the experiment with sampling
                 proportion rho -->
            <parameter id="samplingRate" spec="parameter.RealParameter"
                       dimension="1" lower="0.0" name="stateNode"
                       upper="1.0">0.0</parameter>

            <!--fix origin to experiment duration 11 -->
            <parameter id="origin"
                       spec="parameter.RealParameter" name="stateNode">11
            </parameter>

            <parameter id="scarring_duration"
                       spec="parameter.RealParameter" name="stateNode">10
            </parameter>

            <!-- fix sampling proportion to ntips/35K cells-->
            <parameter id="samplingProportion"
                       spec="parameter.RealParameter" lower="0.0"
                       name="stateNode" upper="1.0">$(sampling_proportion)</parameter>


            <plate var="n" range="$(range_tbcs)">
                <parameter id="missProb_$(n)" spec="parameter.RealParameter"
                           lower="0.0" name="stateNode"
                           upper="1"> 0.1 </parameter>
            </plate>

            <plate var="n" range="$(range_tbcs)">
                <parameter id="missRate_$(n)" spec="parameter.RealParameter"
                           lower="0.0" name="stateNode"
                           upper="Infinity"> 0.1 </parameter>
            </plate>


        </state>



        <!-- define posterior -->
        <distribution id="posterior" spec="CompoundDistribution">

            <!-- tree prior or phylodynamic model. Here, we use a birth-death sampling
            model -->
            <distribution id="prior" spec="CompoundDistribution">
	      
	      <distribution id="GrowthRateLowerBound" spec="beast.base.inference.distribution.Prior">
                   <x id="netGrowthRate" spec="beast.base.inference.util.RPNcalculator">
                       <parameter idref="birthRate"/>
                      <parameter idref="deathRate"/>
                     <expression>birthRate deathRate -</expression>
                  </x>
    
             <distr id="Uniform.PositiveGrowth" spec="beast.base.inference.distribution.Uniform" lower="0.0" upper="Infinity"/>
            </distribution>


                <distribution id="birthDeathMigration.t:alignment" spec="bdsky.evolution.speciation.BirthDeathSkylineModel"
                              birthRate="@birthRate"
			      birthRateChangeTimes="@changeTimes"
			      deathRateChangeTimes="@changeTimes" deathRate="@deathRate" samplingRate="@samplingRate"
                              contemp="true" origin="@origin" rho="@samplingProportion"
                              tree="@typewriterTree" conditionOnSurvival="true"/>


                <!-- prior distribution on phylogenetic parameters -->
                <distribution spec="distribution.Prior"
                        id="editProbabilitiesPrior" name="distribution"
                        x="@editProbabilities">

                    <Dirichlet name="distr" spec="beast.base.inference.distribution.Dirichlet">
                        <parameter  spec="parameter.RealParameter"
                                    estimate="false"
                                    name="alpha" dimension="$(dimension_insertBC)">1.5</parameter>
                    </Dirichlet>
                </distribution>

                <!--Clock prior -->
                <plate var="n" range="$(range_tbcs)">
                    <distribution spec="distribution.Prior"
                                  name="distribution" x="@clockRate_$(n)">
                        <LogNormal spec="distribution.LogNormalDistributionModel" name="distr" M="-1.1" S="0.8"/>
                    </distribution>
                </plate>


                <plate var="n" range="$(range_tbcs)">
                    <distribution spec="distribution.Prior" name="distribution" x="@missRate_$(n)">
                        <LogNormal spec="distribution.LogNormalDistributionModel" name="distr" M="-4.57" S="1.0"/>
                    </distribution>
                </plate>

                
                <plate var="n" range="$(range_tbcs)">
                    <distribution spec="distribution.Prior" x="@missProb_$(n)">
                        <Beta spec="distribution.Beta" name="distr" alpha="4" beta="6"/>
                    </distribution>
                </plate>
                
               

		 <!-- birthRate OU Prior-->
                <distribution id="birthRate_prior"
			      spec="bdsky.OUPrior" x="@birthRate"
			      times="@changeTimes"
			      mean="@birthRate.mu"
			      sigma="@birthRate.sigma"
			      nu="@birthRate.nu">
                </distribution>

                <!-- birthRate Hyperpriors -->
                <distribution id="birthRate.mu_prior"
			      spec="beast.base.inference.distribution.Prior"
			      x="@birthRate.mu">
                    <distr
			spec="beast.base.inference.distribution.LogNormalDistributionModel"
			M="0.1" S="1.0" offset="0.0"
			meanInRealSpace="false"/>
                </distribution>

                <distribution id="birthRate.sigma_prior"
			      spec="beast.base.inference.distribution.Prior"
			      x="@birthRate.sigma">
                    <distr
			spec="beast.base.inference.distribution.LogNormalDistributionModel"
			M="0" S="0.5" offset="0.0"
			meanInRealSpace="false"/>
                </distribution>

                <distribution id="birthRate.nu_prior"
			      spec="beast.base.inference.distribution.Prior"
			      x="@birthRate.nu">
                    <distr
			spec="beast.base.inference.distribution.LogNormalDistributionModel"
			M="0" S="0.5" offset="0.0"
			meanInRealSpace="false"/>
                </distribution>


	        <!-- deathRate OU Prior-->
                <distribution id="deathRate_prior"
			      spec="bdsky.OUPrior" x="@deathRate"
			      times="@changeTimes"
			      mean="@deathRate.mu"
			      sigma="@deathRate.sigma"
			      nu="@deathRate.nu">
                        </distribution>

                <!--deathRate Hyperpriors -->
                <distribution id="deathRate.mu_prior"
			      spec="beast.base.inference.distribution.Prior"
			      x="@deathRate.mu">
                    <distr
			spec="beast.base.inference.distribution.LogNormalDistributionModel"
			M="-0.4" S="1.0" offset="0.0"
			meanInRealSpace="false"/>
                </distribution>

                <distribution id="deathRate.sigma_prior"
			      spec="beast.base.inference.distribution.Prior"
			      x="@deathRate.sigma">
                    <distr
			spec="beast.base.inference.distribution.LogNormalDistributionModel"
			M="0" S="0.5" offset="0.0"
			meanInRealSpace="false"/>
                </distribution>

                <distribution id="deathRate.nu_prior"
			      spec="beast.base.inference.distribution.Prior"
			      x="@deathRate.nu">
                    <distr
			spec="beast.base.inference.distribution.LogNormalDistributionModel"
			M="0" S="0.5" offset="0.0"
			meanInRealSpace="false"/>
                </distribution>

	      </distribution>

	    

            <!-- Typewriter tree likelihood -->
            <distribution id="likelihood" spec="CompoundDistribution" useThreads="true">

                <plate var="n" range="$(range_tbcs)">
                    <distribution id="treeLikelihood$(n)" spec="sciphy.evolution.likelihood.SciPhyTreeLikelihood"
                                  data="@data_$(n)"
                                  tree="@typewriterTree" origin="@origin" useScaling="true"
                                  arrayLength="@arrayLength_$(n)" branchRateModel="@StrictClock_$(n)">

                        <siteModel spec="SiteModel" >
                            <parameter spec="parameter.RealParameter" estimate="false" name="mutationRate">1.0</parameter>
                            <parameter  spec="parameter.RealParameter" estimate="false" lower="0.0" name="proportionInvariant" upper="1.0">0.0</parameter>
                            <substModel spec="sciphy.evolution.substitutionmodel.SciPhySubstitutionModel" missingRate="@missRate_$(n)" missingProbability="@missProb_$(n)" editProbabilities="@editProbabilities">
                                <frequencies spec="beast.base.evolution.substitutionmodel.Frequencies" frequencies="1.0 0.0" estimate="false"/>
                            </substModel>
                        </siteModel>
                    </distribution>
                </plate>

            </distribution>
        </distribution>

        <!-- phylogenetic operators -->
        <operator id="editProbabilitiesOperator"
                  spec="DeltaExchangeOperator"
                  parameter="@editProbabilities"
                  weight="10.0"/>

        <plate var="n" range="$(range_tbcs)">
            <operator id="clockRateScaler_$(n)" spec="kernel.BactrianScaleOperator"
                      parameter="@clockRate_$(n)" scaleFactor="0.8" weight="1.0"/>
        </plate>

        <plate var="n" range="$(range_tbcs)">
            <operator id="missRateScaler_$(n)" spec="kernel.BactrianScaleOperator"
                      parameter="@missRate_$(n)" scaleFactor="0.8" weight="1.0"/>
        </plate>

        <plate var="n" range="$(range_tbcs)">
            <operator id="missProbScaler_$(n)" spec="kernel.BactrianScaleOperator"
                      parameter="@missProb_$(n)" scaleFactor="0.8" weight="1.0"/>
        </plate>

        <!-- tree operators -->
        <operator spec="kernel.BactrianScaleOperator" tree="@typewriterTree" weight="0.8"/>
        <operator spec="WilsonBalding" tree="@typewriterTree" weight="10.0"/>
        <!--operator spec="Uniform" tree="@typewriterTree"
                  weight="10.0"/-->
        <operator spec="Exchange"
                  isNarrow="true" tree="@typewriterTree"
                  weight="10.0"/>
        <operator spec="SubtreeSlide" tree="@typewriterTree" weight="10.0"/>



        <operator id="updown_treeClock" spec="kernel.BactrianUpDownOperator" scaleFactor="0.8" weight="1.5">
                <plate var="n" range="$(range_tbcs)">
                    <up idref="clockRate_$(n)"/>
                </plate>
                <down idref="typewriterTree"/>
        </operator>
        


        <!-- Phylodynamic operators -->
        <operator id="birthRateScaler" spec="kernel.BactrianScaleOperator" parameter="@birthRate" scaleFactor="0.8" weight="3.0"/>

        <operator id="deathRateScaler" spec="kernel.BactrianScaleOperator" parameter="@deathRate" scaleFactor="0.8" weight="3.0"/>

        <operator id="updownBR" spec="kernel.BactrianUpDownOperator" scaleFactor="0.8" weight="1.5">
            <up idref="birthRate"/>
            <down idref="deathRate"/>
        </operator>

        <operator id="upupBR" spec="kernel.BactrianUpDownOperator" scaleFactor="0.9" weight="1.5">
            <up idref="birthRate"/>
            <up idref="deathRate"/>
        </operator>



	 <!-- OU hyperparameter operators -->
        <operator id='birthRate.mu_scaler'
		  spec='kernel.BactrianScaleOperator'
		  scaleFactor=".75" weight="1"
		  parameter="@birthRate.mu"/>
        <operator id='birthRate.sigma_scaler'
		  spec='kernel.BactrianScaleOperator'
		  scaleFactor=".75" weight="1"
		  parameter="@birthRate.sigma"/>
        <operator id='birthRate.nu_scaler'
		  spec='kernel.BactrianScaleOperator'
		  scaleFactor=".75" weight="1"
		  parameter="@birthRate.nu"/>

        <operator id='deathRate.mu_scaler'
		  spec='kernel.BactrianScaleOperator'
		  scaleFactor=".75" weight="1"
		  parameter="@deathRate.mu"/>
        <operator id='deathRate.sigma_scaler'
		  spec='kernel.BactrianScaleOperator'
		  scaleFactor=".75" weight="1"
		  parameter="@deathRate.sigma"/>
        <operator id='deathRate.nu_scaler'
		  spec='kernel.BactrianScaleOperator'
		  scaleFactor=".75" weight="1"
		  parameter="@deathRate.nu"/>

        <!-- Loggers -->
        <logger id="tracelog" spec="Logger" fileName="log/pos_mGASv2_Lane$(lane)_Clustering$(clustering)_Cluster$(cluster).$(seed).log" logEvery="10000">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <plate var="n" range="$(range_tbcs)">
                <log idref="treeLikelihood$(n)"/>
            </plate>
            <log idref="prior"/>
            <log id="treeHeight.t:alignment" spec="beast.base.evolution.tree.TreeHeightLogger" tree="@typewriterTree"/>
            <log idref="editProbabilities"/>
            <log idref="birthRate"/>
            <log idref="samplingProportion"/>
            <log idref="deathRate"/>
            <plate var="n" range="$(range_tbcs)">
                <log idref="clockRate_$(n)"/>
            </plate>
            <plate var="n" range="$(range_tbcs)">
                <log idref="missRate_$(n)"/>
            </plate>
            <plate var="n" range="$(range_tbcs)">
                <log idref="missProb_$(n)"/>
            </plate>
            <log idref='birthRate.mu'/>
            <log idref='birthRate.sigma'/>
            <log idref='birthRate.nu'/>
            <log idref='deathRate.mu'/>
            <log idref='deathRate.sigma'/>
            <log idref='deathRate.nu'/>
	    
        </logger>


        <logger id="screenlog" spec="Logger" logEvery="5000">
            <log idref="posterior"/>
            <log id="ESS.0" spec="util.ESS" arg="@posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
        </logger>

        <logger id="treelog.t:alignment" spec="Logger" fileName="log/pos_mGASv2_Clustering$(clustering)_Lane$(lane)_Cluster$(cluster).$(seed).trees" logEvery="10000" mode="tree">
            <log idref="typewriterTree" printMetaData="true"/>
        </logger>


    </run>

</beast>
