<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<beast beautitemplate='MultiTypeBirthDeath' beautistatus=''
       namespace="lineageTree.substitutionmodel.ScarringLoss:beast.pkgmgmt:beast.base.core:beast.base.inference:beast.base.evolution.alignment:beast.base.evolution.tree.coalescent:beast.base.util:beast.base.math:beast.evolution.nuc:beast.base.evolution.operator:beast.base.inference.operator:beast.base.evolution.sitemodel:beast.base.evolution.substitutionmodel:beast.base.evolution.likelihood"
       required="" version="2.6">
<!-- input alignment, nrOfStates = 15 = 1 + 1 + 13 = unedited state +
     silenced state + 13 scarred states -->
    <data  id="h3n2_2deme" spec="feast.fileio.AlignmentFromNexus" name="alignment" fileName="data/simulate_with_both_sampling=0.00003.seed=$(seed).alignment.tidetree">
        <userDataType spec="tidetree.evolution.datatype.EditData" nrOfStates="15" />

    </data>

  <map name="Uniform">beast.base.inference.distribution.Uniform</map>
    <map name="Exponential">beast.base.inference.distribution.Exponential</map>
    <map name="LogNormal">beast.base.inference.distribution.LogNormalDistributionModel</map>
    <map name="Normal">beast.base.inference.distribution.Normal</map>
    <map name="Beta">beast.base.inference.distribution.Beta</map>
    <map name="Gamma">beast.base.inference.distribution.Gamma</map>
    <map name="LaplaceDistribution">beast.base.inference.distribution.LaplaceDistribution</map>
    <map name="prior">beast.base.inference.distribution.Prior</map>
    <map name="InverseGamma">beast.base.inference.distribution.InverseGamma</map>
    <map name="OneOnX">beast.base.inference.distribution.OneOnX</map>

<!-- set all tip dates, time points of sampling to 25 time units -->
<traitSet id="dateTrait.t:h3n2_2deme"
          spec="beast.base.evolution.tree.TraitSet"
          taxa="@TaxonSet.0" traitname="date-forward" value="0=25"
	  />
<!-- set of all cells -->
<taxa id="TaxonSet.0" spec="beast.base.evolution.alignment.TaxonSet">
  <alignment idref="h3n2_2deme"/>
</taxa>

<!-- run MCMC with 10^9 steps --> 
<run id="mcmc" spec="beast.base.inference.MCMC" chainLength="1000000000">
    <state id="state" spec="beast.base.inference.State" storeEvery="5000">

      <!-- build starting tree -->
        <stateNode id="Tree.t:h3n2_2deme"  spec="sciphy.evolution.tree.startingTree" rootHeight="24.999"
                   taxa="@h3n2_2deme" scarringHeight="24.999"
                   scarringDuration="24.999" sequencesAreClustered="false">
            <trait idref="dateTrait.t:h3n2_2deme"/>
            <taxonset idref="TaxonSet.0"/>
        </stateNode>

        <!-- starting parameter values -->
      <parameter id="editRate" spec="beast.base.inference.parameter.RealParameter"
		   dimension="13" lower="0.0" name="stateNode"
		   upper="1000">
	0.1 0.2 0.4 0.5 0.6 0.7 0.8 0.9 1.1 1.2 1.3 1.4 1.0
      </parameter>

      <parameter id="lossRate" spec="beast.base.inference.parameter.RealParameter"
		   dimension="1" lower="0.0" name="stateNode"
		   upper="1000"> 0.1 </parameter>

        <parameter id="dropoutProb" spec="beast.base.inference.parameter.RealParameter"
                   dimension="1" lower="0.0" name="stateNode"
                   upper="1000"> 0.1 </parameter>
      
	<parameter id="clockRate" spec="beast.base.inference.parameter.RealParameter"
			   dimension="1" lower="0.0" name="stateNode"
			   upper="1000"> 0.1 </parameter>

        <parameter id="birthRate" spec="beast.base.inference.parameter.RealParameter" dimension="1" lower="0.0" name="stateNode" upper="Infinity">0.3</parameter>
        <parameter id="deathRate" spec="beast.base.inference.parameter.RealParameter"
		   dimension="1" lower="0.0" name="stateNode"
		   upper="Infinity">0.2</parameter>
	<!-- The sampling rate through time is set to 0 as we only
	     sample at the end of the experiment with sampling
	     proportion rho -->
        <parameter id="samplingRate" spec="beast.base.inference.parameter.RealParameter"
		   dimension="1" lower="0.0" name="stateNode"
		   upper="1.0">0.0</parameter>
	<!--fix origin to experiment duration, e.g. 25 -->
        <parameter id="origin_BDSKY_Contemp.t:input_alignment" spec="beast.base.inference.parameter.RealParameter" name="stateNode">25</parameter>
        <parameter id="rho_BDSKY_Contemp.t:input_alignment" spec="beast.base.inference.parameter.RealParameter" lower="0.0" name="stateNode" upper="1.0">0.00003</parameter>
        <parameter id="freqParameter.s:h3n2_2deme" spec="beast.base.inference.parameter.RealParameter" dimension="3" lower="0.0" name="stateNode" upper="1.0">1.0 0.0 0.0</parameter>
    </state>

    <!-- define posterior -->
    <distribution id="posterior" spec="beast.base.inference.CompoundDistribution">

      <!-- tree prior or phylodynamic model. Here, we use a birth-death sampling
      model -->
        <distribution id="prior" spec="beast.base.inference.CompoundDistribution">
            <distribution id="birthDeathMigration.t:h3n2_2deme" spec="bdsky.evolution.speciation.BirthDeathSkylineModel"
                          birthRate="@birthRate" deathRate="@deathRate" samplingRate="@samplingRate"
                          contemp="true" origin="@origin_BDSKY_Contemp.t:input_alignment" rho="@rho_BDSKY_Contemp.t:input_alignment"
                           tree="@Tree.t:h3n2_2deme"
			   conditionOnSurvival="true" >
            </distribution>
	    
            <!-- prior distribution on phylogenetic parameters -->
            <prior spec="bdmmprime.util.priors.SmartZeroExcludingPrior"
                   id="editRatePrior" name="distribution"
                   x="@editRate">
                <Exponential name="distr">
                    <parameter  spec="parameter.RealParameter" estimate="false" name="mean">2.0</parameter>
                </Exponential>
            </prior>


            <prior id="ClockPrior.c:alignment" name="distribution" x="@clockRate">
                <LogNormal name="distr" M="-4" S="0.5"/>
            </prior>

            <prior id="DropoutProb.c:alignment" name="distribution" x="@dropoutProb">
                <Beta name="distr" alpha="3" beta="7"/>
            </prior>

            <prior id="lossRate.c:alignment" name="distribution" x="@lossRate">
                <LogNormal name="distr" M="-1" S="1.0"/>
            </prior>

            <prior id="birthPrior" name="distribution" x="@birthRate">
                <LogNormal name="distr" M="-0.2231436" S="1.0"/>
            </prior>

            <prior id="deathPrior" name="distribution" x="@deathRate">
                <LogNormal name="distr" M="-1.609438" S="1.0"/>
            </prior>

	    
        </distribution>
        <!-- TiDeTree tree likelihood -->
        <distribution id="likelihood" spec="beast.base.inference.CompoundDistribution">
            <distribution id="treeLikelihood.h3n2_2deme"
			  spec="tidetree.distributions.TreeLikelihoodWithEditWindow"
			  data="@h3n2_2deme" tree="@Tree.t:h3n2_2deme"
			  origin="@origin_BDSKY_Contemp.t:input_alignment" >
                <siteModel id="SiteModel.s:h3n2_2deme" spec="beast.base.evolution.sitemodel.SiteModel">
                    <mutationRate idref="clockRate"/>
                    <parameter id="proportionInvariant.s:h3n2_2deme"
			       spec="beast.base.inference.parameter.RealParameter"
			       estimate="false" lower="0.0"
			       name="proportionInvariant"
			       upper="1.0">0.0
		    </parameter>
                    <substModel id="JC69.s:h3n2_2deme" spec="tidetree.substitutionmodel.EditAndSilencingModel" editRates="@editRate" silencingRate="@lossRate" missingProbability="@dropoutProb"
				editHeight="25" editDuration="25" >
                      <frequencies id="freq" spec="beast.base.evolution.substitutionmodel.Frequencies" frequencies="@freqParameter.s:h3n2_2deme" estimate="false"/>
                    </substModel>
                </siteModel>
                <branchRateModel id="StrictClock.c:h3n2_2deme" spec="beast.base.evolution.branchratemodel.StrictClockModel" clock.rate="1.0"/>
            </distribution>
        </distribution>
    </distribution>

    <!-- tree operators-->
   <operator id="treeWB" spec="beast.base.evolution.operator.WilsonBalding"
              tree="@Tree.t:h3n2_2deme" weight="30.0"/>

    <operator id="Unif" spec="Uniform" tree="@Tree.t:h3n2_2deme" weight="3.0"/>

    <operator id="SubtreeSlideOperator" spec="SubtreeSlide" tree="@Tree.t:h3n2_2deme" weight="3.0"/>
    <operator id="BDSKY_ContempWide.t:input_alignment" spec="Exchange" isNarrow="false" tree="@Tree.t:h3n2_2deme" weight="30.0"/>
    <operator id="updown_tbr" spec="UpDownOperator" scaleFactor="0.9" weight="10.0">
      <up idref="birthRate"/>
      <down idref="Tree.t:h3n2_2deme"/>
    </operator>

    <operator spec="beast.base.evolution.operator.ScaleOperator" rootOnly="true" tree="@Tree.t:h3n2_2deme" weight="3.0"/>

    <!-- phylogenetic operators -->
    <operator id="scarRateScaler"
              spec="bdmmprime.util.operators.SmartScaleOperator"
              parameter="@editRate" scaleFactor="0.8"
              weight="3.0" classesToExclude="1.0"/>

    <operator id="clockRateScaler" spec="ScaleOperator"
	      parameter="@clockRate" scaleFactor="0.8" weight="10.0"/>

    <operator id="dropProbScaler" spec="ScaleOperator"
              parameter="@dropoutProb" scaleFactor="0.8" weight="10.0"/>

    <operator id="lossRateScaler" spec="ScaleOperator"
              parameter="@lossRate" scaleFactor="0.8" weight="10.0"/>


    <!-- Phylodynamic operators -->
    <operator id="birthRateScaler" spec="ScaleOperator" parameter="@birthRate" scaleFactor="0.8" weight="3.0"/>

    <operator id="deathRateScaler" spec="ScaleOperator" optimise="false" parameter="@deathRate" scaleAll="true" scaleFactor="0.9" weight="3.0"/>

    <!-- Loggers -->
    <logger id="tracelog" spec="Logger" fileName="log/$(filebase).$(seed).log" logEvery="1000">
        <log idref="posterior"/>
        <log idref="likelihood"/>
        <log idref="prior"/>
        <log idref="treeLikelihood.h3n2_2deme"/>
        <log id="treeHeight.t:h3n2_2deme" spec="beast.base.evolution.tree.TreeHeightLogger" tree="@Tree.t:h3n2_2deme"/>
        <log id="treeLength.t:h3n2_2deme" spec="multitypetree.util.TreeLengthLogger" tree="@Tree.t:h3n2_2deme"/>
        <log idref="editRate"/>
        <log idref="lossRate" />
        <log idref="dropoutProb" />
        <log idref="birthRate"/>
        <log idref="rho_BDSKY_Contemp.t:input_alignment"/>
        <log idref="deathRate"/>
        <log idref="clockRate"/>
    </logger>

    <logger id="screenlog" spec="Logger" logEvery="1000">
        <log idref="posterior"/>
        <log id="ESS.0" spec="util.ESS" arg="@posterior"/>
        <log idref="likelihood"/>
        <log idref="prior"/>
    </logger>

    <logger id="treelog.t:h3n2_2deme" spec="Logger" fileName="log/$(filebase).$(tree).$(seed).trees" logEvery="1000" mode="tree">
        <log idref="Tree.t:h3n2_2deme" printMetaData="true"/>
    </logger>


</run>

</beast>
